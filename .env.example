# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- MT5 account ---
# The terminal must be the one your broker ships: a broker-branded MT5 only
# accepts that broker's servers (the FTMO terminal cannot log into VTMarkets-Demo,
# and vice versa). Quote the password with single quotes if it contains $ or #.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=VTMarkets-Demo        # or FTMO-Demo, etc.
# Path to the MetaTrader 5 terminal64.exe (Windows). Leave blank to auto-detect
# — but set it explicitly when several terminals are installed, so a wrong or
# missing install fails loudly instead of attaching to the wrong terminal.
MT5_TERMINAL_PATH=

# --- Rule set ---
# ftmo -> full FTMO prop-firm ruleset (daily-loss floor, overall-loss floor,
#         consistency rule, weekend flatten, news blackout).
# none -> plain broker account: none of the above apply.
# Per-trade risk sizing (--risk-pct), the kill switch and the startup
# reconciliation gate stay active in either mode.
RULES_MODE=none                  # 'none' for a plain broker demo (VT Markets); 'ftmo' for a prop account

# Optional self-imposed equity floors (fractions of ACCOUNT_INITIAL_CAPITAL).
# Blank = off. Under RULES_MODE=none these are the ONLY equity floors there are.
SELF_DAILY_LOSS_PCT=
SELF_OVERALL_LOSS_PCT=0.60      # hard stop for the H4 bot: flatten + halt at ~60% loss

# --- Account profile (drives the Compliance Engine rules) ---
# Under RULES_MODE=none, variant/path/phase are inert but must stay valid
# (account_profile CHECK-constrains them). ACCOUNT_INITIAL_CAPITAL is still the
# base for the SELF_*_LOSS_PCT floors — keep it at the account's start balance.
ACCOUNT_VARIANT=standard        # standard | swing
ACCOUNT_PATH=2-step             # 1-step | 2-step
ACCOUNT_PHASE=challenge         # challenge | verification | funded
ACCOUNT_INITIAL_CAPITAL=10000   # the account's starting balance

# --- PostgreSQL (existing docker container) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=FTMO
PGUSER=postgres
PGPASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/FTMO

# --- Discord webhooks ---
DISCORD_TRADE_WEBHOOK=
DISCORD_NEWS_WEBHOOK=
ADVISORY_WEBHOOK=                # optional: signal_bot advisory channel

# --- News / economic calendar ---
NEWS_SYMBOLS=XAUUSD-ECN          # VT Markets' tradeable gold symbol
NEWS_CURRENCIES=USD
